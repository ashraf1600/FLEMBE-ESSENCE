# Django Core
DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (Render PostgreSQL provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host:port/dbname
# Or configure individual DB variables:
DB_ENGINE=postgresql
DB_NAME=flembe_essence
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://flembe-essence-frontend.onrender.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://flembe-essence-frontend.onrender.com

# Auto seed & Superuser for Render initial deployment (optional)
AUTO_SEED=true
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@flembeessence.com
DJANGO_SUPERUSER_PASSWORD=ChangeThisPassword123!

# Cloudinary (recommended on Render for media/product image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

